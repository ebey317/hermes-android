# LLM API keys
# Get keys from the provider websites listed below.
# Do NOT commit this file with real values.

# Ollama Cloud — required by default
# https://ollama.com/settings
OLLAMA_API_KEY=your_ollama_cloud_key_here

# Optional fallbacks
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Termux-specific: preload libpython so Rust/C extensions resolve symbols
LD_PRELOAD=/data/data/com.termux/files/usr/lib/libpython3.14.so
